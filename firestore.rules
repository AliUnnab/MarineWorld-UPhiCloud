rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Authentication Helper
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    // Tenant Membership Verification Helper
    function isCompanyMember(companyId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId
      );
    }

    // Role-based Access Helpers
    function isCompanyRole(companyId, allowedRoles) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.role in allowedRoles
      );
    }

    // User Profile Documents (/users/{uid})
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == uid;

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Public Registry & Taxonomy Collections (Read-only for public, Admin write)
    match /sectors/{sectorId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /sectorCities/{sectorCityId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /businessIds/{businessId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Ecosystem Organizations (/ecosystemOrganizations/{orgId})
    match /ecosystemOrganizations/{orgId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /members/{memberId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // Company Entity & Subcollections (/companies/{companyId})
    match /companies/{companyId} {
      allow read: if true; // Public company profiles are readable
      allow write: if isSignedIn() && isCompanyMember(companyId);

      // Subcollection: members
      match /members/{memberUid} {
        allow read: if isCompanyMember(companyId);
        allow write: if isSignedIn() && (request.auth.uid == memberUid || isCompanyRole(companyId, ['OWNER', 'ADMIN']));
      }

      // Subcollection: offerings (products, services)
      match /products/{productId} {
        allow read: if true;
        allow write: if isCompanyMember(companyId);
      }

      match /services/{serviceId} {
        allow read: if true;
        allow write: if isCompanyMember(companyId);
      }

      // Subcollection: documents & data spaces (Confidential)
      match /documents/{docId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isCompanyRole(companyId, ['OWNER', 'ADMIN', 'TECHNICAL', 'OPERATIONS']);
      }

      // Subcollection: commercial invoices & billing
      match /commercialInvoices/{invoiceId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isCompanyRole(companyId, ['OWNER', 'ADMIN', 'COMMERCIAL']);
      }

      // Subcollection: governance revisions
      match /governanceRevisions/{revisionId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isCompanyRole(companyId, ['OWNER', 'ADMIN']);
      }

      // Catch-all for other company subcollections
      match /{subcollection}/{docId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isCompanyMember(companyId);
      }
    }

    // Inquiries & RFQs (/inquiries/{inquiryId})
    match /inquiries/{inquiryId} {
      allow read: if isSignedIn() && (
        resource.data.requesterUid == request.auth.uid ||
        isCompanyMember(resource.data.targetCompanyId)
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.requesterUid == request.auth.uid ||
        isCompanyMember(resource.data.targetCompanyId)
      );
    }

    // Commercial Agreements & Lease Intents
    match /commercialAgreements/{agreementId} {
      allow read: if isSignedIn() && (
        resource.data.companyId == null ||
        isCompanyMember(resource.data.companyId)
      );
      allow write: if isSignedIn();
    }

    match /reservationIntents/{intentId} {
      allow read, write: if isSignedIn();
    }

    // Company Analytics & Telemetry
    match /companyAnalytics/{companyId}/events/{eventId} {
      allow read: if isCompanyMember(companyId);
      allow create: if true; // Telemetry event ingest
    }

    // Fallback: Deny any unspecified access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
